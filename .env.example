NODE_ENV=development
PORT=3000

# Required in production. Optional locally until you wire a real database client.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/express_template

# Comma-separated allowlist. "*" is allowed outside production only.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=false

# Required in production. Must be at least 32 characters.
JWT_SECRET=replace-with-at-least-32-characters-secret

LOG_LEVEL=info
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LIMIT=100
